{
  "compilerOptions": {
    "target": "ESNext",              // versão moderna do JavaScript
    "module": "CommonJS",            // compatível com Node.js sem precisar "type": "module"
    "rootDir": "./src",              // onde ficam seus arquivos .ts
    "outDir": "./dist",              // onde serão gerados os .js
    "types": ["node"],               // adiciona suporte às APIs do Node
    "strict": true,                  // ativa checagem rigorosa de tipos
    "esModuleInterop": true,         // permite usar import/export com módulos CommonJS
    "skipLibCheck": true,            // ignora checagem de tipos em libs externas
    "sourceMap": true                // gera mapas de código para debug
  },
  "include": ["src/**/*.ts"]
}
